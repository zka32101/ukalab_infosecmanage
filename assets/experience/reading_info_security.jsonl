// IPA公式の過去問・サンプル問題・シラバスの転載はしていない。運営者確認・一次資料での裏取りが必要（確認前の仮データ）。
{"readingId": "reading-kamoku_a", "examId": "info_security", "subjectId": "kamoku_a", "title": "科目A（知識）", "sections": [{"heading": "情報セキュリティの基本", "body": "三要素は機密性・完全性・可用性。脅威が脆弱性に付け込むとリスクになる。リスク対応は回避・低減・移転・保有の4つで、対策後に残るのが残存リスク。まず『何を守るか（情報資産）』を押さえる。"}, {"heading": "管理と対策", "body": "ISMSはPDCAで回し、方針は経営層が承認して周知する。技術では暗号（共通鍵・公開鍵）、ハッシュ、デジタル署名、多要素認証、WAF、パッチ適用、バックアップが定番。攻撃は手口の名前と防ぎ方をセットで覚える。"}, {"heading": "法務と関連分野", "body": "個人情報保護法、不正アクセス禁止法、不正競争防止法（営業秘密の三要件）は頻出。システム監査・内部統制・委託先管理・クラウドの責任共有も、用語と目的を結びつけて学ぶ。"}], "relatedTermIds": [], "relatedQuestionIds": [], "source": "original", "sourceRef": "自作の解説（一般的な基礎知識）", "contentVer": "2026.10.1"}
{"readingId": "reading-kamoku_b", "examId": "info_security", "subjectId": "kamoku_b", "title": "科目B（事例）", "sections": [{"heading": "事例問題の解き方", "body": "事例問題は、登場する組織の状況（誰が、何を、どう扱っているか）を整理し、何が問題かを一つに絞って考える。選択肢は『最小限の権限』『記録を残す』『経営層の承認』『報告を早く』『証拠を保全』といった原則に沿うものを選ぶ。"}, {"heading": "よく出る場面", "body": "ルールの策定と見直し、リスクの評価、インシデント初動、アカウントと権限の管理、委託先とクラウド、テレワークと私物端末。各場面で『まず隔離・報告』『最小権限』『個別ID』『暗号化』など、定番の考え方を当てはめる。"}], "relatedTermIds": [], "relatedQuestionIds": [], "source": "original", "sourceRef": "自作の解説（一般的な基礎知識）", "contentVer": "2026.10.1"}
{"readingId": "reading-kamoku_b-risk-response", "examId": "info_security", "subjectId": "kamoku_b", "title": "科目B：リスクの洗い出しと対応の選び方", "sections": [{"heading": "まず洗い出す", "body": "事例では、先に守る対象を確かめる。何の情報が、どこにあり、誰が扱うのか。次に、どんな脅威がどんな弱点を突くと困るのかを考える。対策の話はそのあとにする。"}, {"heading": "評価して優先順位をつける", "body": "洗い出したリスクは、影響の大きさと起きやすさで比べる。すべてを同時に直すことはできないので、大きいものから手を付ける。基準はあらかじめ決めておき、担当者の感覚に任せない。"}, {"heading": "対応を選ぶ", "body": "対応の選び方は、避ける、減らす、移す、受け入れる、の四つ。費用や業務への影響と見合うかを考えて選ぶ。受け入れる場合も、理由と承認者を残す。対策後に残るリスクは、見直しの対象になる。"}], "relatedTermIds": ["info_security_term-0008", "info_security_term-0293", "info_security_term-0113", "info_security_term-0009", "info_security_term-0112", "info_security_term-0251"], "relatedQuestionIds": [], "source": "original", "sourceRef": "自作の解説（AI下書き・専門家確認前）", "contentVer": "2026.10.2", "tags": ["ai-draft"]}
{"readingId": "reading-kamoku_b-asset-classification", "examId": "info_security", "subjectId": "kamoku_b", "title": "科目B：情報資産の分類と取扱い", "sections": [{"heading": "資産を把握する", "body": "守る対象が分からなければ、対策は的外れになる。情報だけでなく、それを保存する機器や、扱う人も含めて一覧にする。一覧には管理者を決め、実態と合わせて更新する。"}, {"heading": "重要度で区分する", "body": "情報は、重要度に応じて数段階に分ける。区分ごとに、保管方法、持出しの可否、共有してよい範囲を決める。区分が曖昧だと、現場の判断がばらつく。"}, {"heading": "区分に沿って扱う", "body": "区分は付けて終わりではない。印刷物や電子ファイルに表示し、廃棄の方法まで区分に合わせる。事例では、重要度に見合った扱いになっているかを確かめる。"}], "relatedTermIds": ["info_security_term-0014", "info_security_term-0091", "info_security_term-0188"], "relatedQuestionIds": [], "source": "original", "sourceRef": "自作の解説（AI下書き・専門家確認前）", "contentVer": "2026.10.2", "tags": ["ai-draft"]}
{"readingId": "reading-kamoku_b-incident-flow", "examId": "info_security", "subjectId": "kamoku_b", "title": "科目B：インシデント対応の流れ", "sections": [{"heading": "気づいたら、まず知らせる", "body": "不審なメールを開いてしまった。端末の動きがおかしい。そんなときは、自分で直そうとしない。決められた連絡先に、すぐ知らせる。報告が早いほど、被害は小さくおさえられる。"}, {"heading": "広げない、残す", "body": "次に、被害を広げないことを考える。疑わしい端末は、ネットワークから切り離す。あわせて、あとで調べられるように、記録を消さずに残す。むやみに電源を切ったり、初期化したりしない。"}, {"heading": "調べて、直して、振り返る", "body": "影響が及んだ範囲を調べ、原因を取り除き、元の状態に戻す。必要な連絡も行う。最後に、なぜ起きたかを振り返り、同じことが起きない対策を決める。振り返りまでが対応である。"}], "relatedTermIds": ["info_security_term-0123", "info_security_term-0181", "info_security_term-0182", "info_security_term-0183", "info_security_term-0230", "info_security_term-0082"], "relatedQuestionIds": [], "source": "original", "sourceRef": "自作の解説（AI下書き・専門家確認前）", "contentVer": "2026.10.2", "tags": ["ai-draft"]}
{"readingId": "reading-kamoku_b-outsourcing", "examId": "info_security", "subjectId": "kamoku_b", "title": "科目B：委託先管理の考え方", "sections": [{"heading": "任せても責任は残る", "body": "業務を外部に委託しても、情報を守る責任が委託元からなくなるわけではない。個人情報などを扱わせる場合は、委託元が委託先を適切に管理する必要がある。"}, {"heading": "選ぶとき、結ぶとき", "body": "委託先を選ぶときは、情報の管理体制や過去の事故への対応を確かめる。契約では、秘密を守ること、再委託の条件、事故が起きたときの報告、終了時の情報の返却や削除を決める。"}, {"heading": "契約したあとも見る", "body": "契約後も、報告を受けたり、定期的に確認したりして、約束どおり運用されているかを見る。問題があれば改善を求める。契約を結んだだけで安心しない。"}], "relatedTermIds": ["info_security_term-0315", "info_security_term-0052", "info_security_term-0051", "info_security_term-0053"], "relatedQuestionIds": [], "source": "original", "sourceRef": "自作の解説（AI下書き・専門家確認前）", "contentVer": "2026.10.2", "tags": ["ai-draft"]}
{"readingId": "reading-kamoku_b-access-log", "examId": "info_security", "subjectId": "kamoku_b", "title": "科目B：アクセス権限の見直しとログの活用", "sections": [{"heading": "権限は定期的に見直す", "body": "異動や退職、担当の変更のたびに、必要な権限は変わる。そのままにすると、不要な権限が積み重なる。定期的に一覧で確かめ、業務に必要な最小限に整える。"}, {"heading": "個別のIDで記録を残す", "body": "一人に一つのIDを割り当てれば、誰が何をしたかを記録から追える。共用のIDでは、操作した人が分からない。管理用の強いIDは、数を絞り、使うときの記録を残す。"}, {"heading": "ログは見てこそ役に立つ", "body": "ログは、保存するだけでは役に立たない。保管する期間を決め、改ざんされないよう守る。そのうえで定期的に確認し、失敗した認証の繰り返しなど、いつもと違う動きに気づく。"}], "relatedTermIds": ["info_security_term-0205", "info_security_term-0050", "info_security_term-0080", "info_security_term-0058", "info_security_term-0048"], "relatedQuestionIds": [], "source": "original", "sourceRef": "自作の解説（AI下書き・専門家確認前）", "contentVer": "2026.10.2", "tags": ["ai-draft"]}
